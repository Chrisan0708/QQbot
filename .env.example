# 复制成 .env 再填值：cp .env.example .env
# 真实 .env 已在 .gitignore 里，不会进仓库

# ===== 机器人基础 =====
ENVIRONMENT=prod
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080

# NapCat 那边必须填一模一样的；公网暴露时请换成随机长串
ONEBOT_ACCESS_TOKEN=change-me-to-a-long-random-string

# 命令前缀：保留 "/"，并允许不加前缀直接说命令（如 "5e xxx"、"cs赛事"）
COMMAND_START=["/", ""]

# ===== htmlrender 出图后端（cs2radar 依赖）=====
# 只写 provider 就行；storage_path 由 docker-compose.yml 覆盖成 /ms-playwright，
# 千万不要在这里写 Windows 路径（C:\Users\...）
RENDER__PROVIDER=playwright

# ===== cs2radar =====
cs2radar_priority=5
cs2radar_http_timeout=15
cs2radar_llm_enabled=true
cs2radar_llm_api_type=openai
cs2radar_llm_api_url=https://api.deepseek.com/v1
cs2radar_llm_api_key=sk-change-me
cs2radar_llm_model=deepseek-chat
cs2radar_llm_timeout=60
cs2radar_llm_backup_enabled=false
cs2radar_llm_backup_api_type=openai
cs2radar_llm_backup_api_url=
cs2radar_llm_backup_api_key=
cs2radar_llm_backup_model=

# ===== 容器对外绑定地址（docker-compose.yml 用）=====
# NapCat 和 bot 在同一台机器  -> 127.0.0.1（推荐，不暴露公网）
# NapCat 在别的网络（家里的电脑连云服务器）-> 0.0.0.0，并在安全组放行 8080
BOT_BIND=127.0.0.1
